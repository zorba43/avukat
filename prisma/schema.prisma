generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Bir kaza bildirim başvurusu — 5 adımlık formun tamamı burada birleşir.
/// id istemci tarafında (crypto.randomUUID()) üretilir; hem birincil anahtar
/// hem de Blob depolamadaki dosya klasör öneki hem de /basvuru/[id] linkinin
/// tahmin edilemez parçası olarak aynı değer kullanılır.
model KazaBildirimi {
  id         String   @id
  /// Kullanıcıya gösterilen kısa/okunabilir kod (örn. GH-2026-4821) — id
  /// (UUID) ile karıştırılmamalı. Ek belge yükleme akışında başvuruyu bulmak
  /// için isim yerine bu kullanılır.
  basvuruNo  String   @unique
  createdAt  DateTime @default(now())

  // Adım 1 — Kişisel bilgiler
  ad              String
  telefon         String
  kazaTarihi      DateTime
  basvuruNiteligi String
  kazaDurumu      String

  // Adım 2 — Ruhsat & Ehliyet (Blob URL'leri)
  ruhsatUrl      String
  ehliyetOnUrl   String
  ehliyetArkaUrl String

  // Adım 2 — Karşı taraf belgeleri (opsiyonel — kaza anında elde olmayabilir)
  karsiTarafRuhsatUrl      String?
  karsiTarafEhliyetOnUrl   String?
  karsiTarafEhliyetArkaUrl String?

  // Adım 3 — Kaza raporu belgeleri (1-5 adet, PDF veya görsel)
  kazaRaporuUrls String[]

  // Adım 4 — Olay yeri fotoğrafları (3-20 adet)
  fotograflarUrls String[]

  // Adım 5 — Tamamla
  kaynak      String
  kaynakDetay String?
}
